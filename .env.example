# Environment Configuration for Vertexon LMS-AI

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=vertexon_lms_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=vertexon_lms_super_secret_refresh_key_2026

# PostgreSQL Database (pgvector enabled)
DATABASE_URL=postgresql://lms:lms123@localhost:5432/lms_ai

# Redis
REDIS_URL=redis://localhost:6379

# AI Service (FastAPI RAG Backend)
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
